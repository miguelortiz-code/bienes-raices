{
  "name": "bienes-raices",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "css": "npx @tailwindcss/cli -i ./public/css/tailwind.css -o ./public/css/app.css --watch",
    "js": "webpack --watch",
    "server": "concurrently \"npm run css \" \"npm run js \" ",
    "db:import": "node seed/seeder.js -i",
    "db:delete": "node seed/seeder.js -d"
  },
  "keywords": [
    "MVC",
    "Pug",
    "Tailwind",
    "MySql",
    " Sequelize"
  ],
  "author": "Miguel Ortiz",
  "license": "ISC",
  "description": "Proyecto de bienes raices donde se pueden publicar casas, apartamentos para poder vender",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.2.2",
    "dotenv": "^16.5.0",
    "dropzone": "^5.9.3",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.3",
    "pug": "^3.0.3",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.10",
    "@tailwindcss/postcss": "^4.1.10",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10",
    "tailwindcss": "^4.1.10",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  }
}
