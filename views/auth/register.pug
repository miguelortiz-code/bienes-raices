extends ../layout/index
block contenido
    .py-10
        h1.text-5xl.my-10.font-extrabold.text-center Bienes
            span.font-normal.ml-2 Raices

        if errors
            div(class="absolute top-5 right-5 max-w-md mx-auto")
                each error in errors                
                    p(class="bg-red-600 rounded-lg transition-all text-white uppercase text-xs text-center p-2 mb-1.5 font-bold")=error.msg
        .mt-8.mx-auto.max-w-md
            .bg-white.py-8.px-4.shadow-lg.rounded-lg
                form(action="/auth/register" method="POST" class="space-y-5")
                    h2(class="text-center text-3xl font-extrabold capitalize text-gray-800")= pagina
                    p(class="text-gray-600 text-center mt-2 text-sm font-medium") Crea tu cuenta para publicar y vender tus propiedades fácilmente
                    
                    input(type="hidden" name="_csrf" value= csrfToken)

                    div
                        label(for="name" class="block text-sm uppercase text-gray-500 mb-2 font-bold") nombre
                        input(type="text" id="name" name="name" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400" placeholder="Jhon Doe" value= user ? user.name : '')
                    
                    div
                        label(for="email" class="block text-sm uppercase text-gray-500 mb-2 font-bold") correo electronico
                        input(type="email" id="email" name="email" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400" placeholder="jhondoe@gmail.com" value= user ? user.email : '')
                    
                    div
                        label(for="password" class="block text-sm uppercase text-gray-500 mb-2 font-bold") contraseña
                        input(type="password" id="password" name="password" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400" placeholder="******")
                    
                    div
                        label(for="confirm_password" class="block text-sm uppercase text-gray-500 mb-2 font-bold") confirmar contraseña
                        input(type="password" id="confirm_password" name="confirm_password" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400" placeholder="******")

                    
                    div(class="flex items-center justify-start gap-2")
                        input(type="checkbox" class="cursor-pointer" id="show_password")
                        label(for="show_password" class="block text-md capitalize text-gray-500 font-bold") mostrar contraseña
                    
                    input(type="submit" value="Registrar Cuenta" class="bg-blue-500 w-full rounded py-2 text-white cursor-pointer hover:bg-blue-700 transition")
                

                    div(class="flex justify-between items-center text-xs text-center")
                        p(class="text-black") ¿Ya tienes cuenta?
                            a(href="/auth/login" class="text-blue-500 hover:text-blue-800  capitalize inline-block ml-2") ingresar

                        p(class="text-black") ¿Olvide mi contraseña?
                            a(href="/auth/recover-password" class="inline-block text-blue-500 hover:text-blue-800 capitalize ml-2") recuperar