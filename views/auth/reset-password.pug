extends ../layout/index
block contenido
    .py-10
        h1.text-5xl.my-10.font-extrabold.text-center Bienes
            span.font-normal.ml-2 Raices
        if errors
            div(class="absolute top-5 right-5 max-w-md mx-auto")
                each error in errors                
                    p(class="bg-red-600 rounded-lg transition-all text-white uppercase text-xs text-center p-2 mb-1.5 font-bold")=error.msg
        .mt-8.mx-auto.max-w-md
            .bg-white.py-8.px-4.shadow-lg.rounded-lg
                form(method="POST" class="space-y-5")
                    input(type="hidden" name="_csrf" value= csrfToken)
                    h2(class="text-center text-3xl font-extrabold capitalize text-gray-800")= pagina
                    p(class="text-gray-600 text-center mt-2 text-sm font-medium") Ingresa tu nueva contraseña y confírmala para poder publicar tus propiedades
                    
                    div
                        label(for="password" class="block text-sm uppercase text-gray-500 mb-2 font-bold") nueva contraseña
                        input(type="password" id="password" name="password" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400" placeholder="*******")
                    
                    div
                        label(for="confirm_password" class="block text-sm uppercase text-gray-500 mb-2 font-bold") confirmar contraseña
                        input(type="password" id="confirm_password" name="confirm_password" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400" placeholder="*******")
    
                    input(type="submit" value="Guardar Contraseña" class="bg-blue-500 w-full rounded py-2 text-white cursor-pointer hover:bg-blue-700 transition")