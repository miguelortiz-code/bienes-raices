extends ../layout/app
block styles
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css")
block contenido
    div(class="py-5")
        h1(class="text-4xl my-10 font-extrabold text-center uppercase")= property.title
        div
            a(href="#" class="font-bold text-gray-600 text-sm capitalize") categoria:
                span(class="font-normal inline-block ml-2")= property.category.category
        
        div(class="mt-5 md:flex md:gap-20")
            //- Mostrando información sobre la propiedad
            div(class="md:w-2/3 bg-white shadow-lg rounded-lg")
                img(src=`/uploads/${property.imagen}` alt=`Imagen de la propiedad ${property.title}`)
                div(class="px-5 py-10 space-y-5")
                    p.mb-8= property.description
                    h2(class="text-2xl leading-6 font-bold text-gray-900") Información de la Propiedad
                    div(class="grid grid-cols-1 md:grid-cols-2 gap-4")

                        p(class="text-gray-600 font-bold text-xs") Habitaciones:
                            span(class="text-gray-800 block text-lg")= property.rooms

                        p(class="text-gray-600 font-bold text-xs") Baños:
                            span(class="text-gray-800 block text-lg")= property.bathrooms

                        p(class="text-gray-600 font-bold text-xs") Parqueadero:
                            span(class="text-gray-800 block text-lg")= property.parking

                        p(class="text-gray-600 font-bold text-xs") Precio:
                            span(class="text-gray-800 block text-lg")= property.price.price
            //- Mostrando mapa y la ubicación de la propiedad
            div(class="md:w-1/3")
                h3(class="text-center py-10 leading-6 text-2xl font-bold text-gra-900") Ubicación
                //- Mapa
                div(class="h-96" id="mapa")
                    p(class="hidden" id="latitude")= property.latitude
                    p(class="hidden" id="longitude")= property.longitude

                div(class="p-5")
                    p(class="text-gray-600 font-bold text-xs") Dirección
                        span(class="text-gray-800 block text-lg" id="street")= property.street
        //- pre= JSON.stringify(property, undefined, 2)

block scripts
    script(src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js")
    script(src="/js/mostrarMapa.js")