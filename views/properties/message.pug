extends ../layout/admin
block contenido
    .py-10
        h2(class="text-center text-3xl font-extrabold uppercase text-black")=pagina
        a(href="/my-properties" class="rounded-lg py-2 px-10 bg-blue-500 hover:bg-blue-700 transition text-sm text-center text-white uppercase inline-block ml-4 sm:ml-8 my-10 mx-auto") volver
        div(class="mx-auto max-w-4xl rounded-lg bg-white shadow-md flex flex-col md:flex-row gap-2")
            if  messages.length
                img(src=`/uploads/${property.imagen}`, alt=`Imagen de la casa: ${property.title}` class="block mx-auto max-w-md w-full md:w-xs object-cover")
                ul
                    each message in messages
                        li(class="border border-gray-200 border-b p-5")
                            p(class="font-bold text-gray-800") Nombre: 
                                span(class="font-normal")= message.user.name
                            p(class="font-bold text-gray-800") Correo electrónico: 
                                span(class="font-normal")= message.user.email
                            p(class="font-bold text-gray-800") Mensaje: 
                                span(class="font-normal")= message.message
                            p(class="font-bold text-gray-800") Enviado: 
                                span(class="font-normal")= formatDate(message.createdAt)
            else
                p(class="text-center text-gray-600 p-5 capitalize") no hay mensajes