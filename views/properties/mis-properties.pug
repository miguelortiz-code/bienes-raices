extends ../layout/admin

block styles
    meta(name="csrf-token" content= csrfToken)

block contenido
    .py-10
        h2(class="text-center text-3xl font-extrabold capitalize text-black")= pagina

        a(href="/properties/new-property" class="rounded-lg py-2 px-10 bg-blue-500 hover:bg-blue-700 transition text-sm text-center text-white uppercase inline-block ml-4 sm:ml-8 my-10 mx-auto") publicar propiedad

        if properties.length
            div(class="bg-white shadow-lg rounded-lg")
                ul(class="divide-y divide-gray-200")
                    each property in properties
                        li
                            div(class="p-6 w-full flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-8 md:space-y-0 gap-4")
                                figure(class="sm:w-1/4 md:w1/6 w-50 h-50")
                                    img(src=(NODE_ENV === 'production' ? `https://res.cloudinary.com/${CLOUDINARY_NAME}/image/upload/uploads/${property.imagen}` : `/uploads/${property.imagen}`) alt=`Imagen de ${property.title}` class="w-full h-full object-cover block")
                                div(class="sm:w-2/4 md:w-3/6 lg:w-4/6 text-center space-y-3")
                                    a(href=`/property/${property.code}` class="inline-block text-2xl font-extrabold text-blue-600 uppercase truncate")= property.title
                                    p(class="text-sm text-black font-bold")= property.category.category
                                    div(class="flex items-center justify-center gap-3")
                                        p(class="text-sm text-black font-bold")
                                           svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5")
                                            path(d="M10.75 10.818v2.614A3.13 3.13 0 0 0 11.888 13c.482-.315.612-.648.612-.875 0-.227-.13-.56-.612-.875a3.13 3.13 0 0 0-1.138-.432ZM8.33 8.62c.053.055.115.11.184.164.208.16.46.284.736.363V6.603a2.45 2.45 0 0 0-.35.13c-.14.065-.27.143-.386.233-.377.292-.514.627-.514.909 0 .184.058.39.202.592.037.051.08.102.128.152Z")
                                            path(fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-6a.75.75 0 0 1 .75.75v.316a3.78 3.78 0 0 1 1.653.713c.426.33.744.74.925 1.2a.75.75 0 0 1-1.395.55 1.35 1.35 0 0 0-.447-.563 2.187 2.187 0 0 0-.736-.363V9.3c.698.093 1.383.32 1.959.696.787.514 1.29 1.27 1.29 2.13 0 .86-.504 1.616-1.29 2.13-.576.377-1.261.603-1.96.696v.299a.75.75 0 1 1-1.5 0v-.3c-.697-.092-1.382-.318-1.958-.695-.482-.315-.857-.717-1.078-1.188a.75.75 0 1 1 1.359-.636c.08.173.245.376.54.569.313.205.706.353 1.138.432v-2.748a3.782 3.782 0 0 1-1.653-.713C6.9 9.433 6.5 8.681 6.5 7.875c0-.805.4-1.558 1.097-2.096a3.78 3.78 0 0 1 1.653-.713V4.75A.75.75 0 0 1 10 4Z" clip-rule="evenodd")
                                        p(class="text-sm text-black font-bold")= property.price.price
                                    a(href=`/message/${property.code}` class="text-sm inline-block capitalize text-gray-500")= `${property.messages.length} Mensajes`

                                div(class="sm:w-1/4 md:w-2/6 lg:w-1/6  flex flex-col gap-2  2xl:flex-row")
                                    button(type="button" data-property-id=`${property.code}` class=`change-state w-full px-2 py-2 cursor-pointer md:py-1 text-xs leading-5 font-semibold rounded-lg ${property.published ? 'bg-green-100 text-green-800': 'bg-yellow-100 text-yellow-800'}`)=`${property.published ? 'Publicado' : 'No Publicado'}`
                                    
                                    a(href=`/properties/edit/${property.code}` class="px-2 py-2 text-center cursor-pointer md:py-1 text-sm leading-5 font-semibold rounded-lg bg-blue-100 text-blue-800") editar

                                    form(action=`/properties/delete/${property.code}` method="POST")
                                        input(type="hidden" name="_csrf" value= csrfToken)
                                        input(type="submit" class='w-full px-2 py-2 cursor-pointer md:py-1 text-xs leading-5 font-semibold rounded-lg bg-red-100 text-red-800' value="Eliminar")
                div(class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6")
                    div(class="flex flex-1 justify-between sm:hidden")
                        //- arrow left
                        a(href=`/my-properties?page=${page - 1}` class=`${page === 1 ? 'pointer-events-none': ''} relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-100`)
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6")
                                path(fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-4.28 9.22a.75.75 0 0 0 0 1.06l3 3a.75.75 0 1 0 1.06-1.06l-1.72-1.72h5.69a.75.75 0 0 0 0-1.5h-5.69l1.72-1.72a.75.75 0 0 0-1.06-1.06l-3 3Z" clip-rule="evenodd")

                        //- arrow right
                        a(href=`/my-properties?page=${page + 1}` class=`${page === pages ? 'pointer-events-none' : ''} relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-100`)
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6")
                                path(fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 10.28a.75.75 0 0 0 0-1.06l-3-3a.75.75 0 1 0-1.06 1.06l1.72 1.72H8.25a.75.75 0 0 0 0 1.5h5.69l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3Z" clip-rule="evenodd")  

                    div(class="hidden sm:flex-1 sm:flex sm:item-center sm:justify-between")
                        p(class="text-sm text-gray-700  gap-2") Mostrando 
                            span(class="font-medium") #{offset + 1} a 
                            span(class="font-medium") #{total < limit + offset ? total : limit + offset} de 
                            span(class="font-medium") #{total} resultados
                    div(class="hidden sm:block")
                        nav(class="relative z-0 inline-flex gap-3 justify-between items-center rounded-md")
                            -var n = 1;
                                while n <= pages
                                    a(href=`/my-properties?page=${n}` class=`${page == n ? 'bg-blue-50 border border-blue-500 text-blue-600' : 'bg-white border-gray-300 text-gray-500 hover:bg-gray-100'}  relative inline-flex px-4 py-2 w-10 h-10 rounded-full border text-sm font-medium `) #{n++}   
        else
            div(class="bg-red-500 py-2 max-w-lg mx-auto")
                p(class="text-white text-center font-bold uppercase") No se encontraron propiedades creadas en tu cuenta

block scripts
    script(src="/js/changeState.js") 