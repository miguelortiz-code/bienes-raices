extends ../layout/admin
block contenido
    .py-10
        h2(class="text-center text-3xl font-extrabold capitalize text-black")= pagina

        a(href="/properties/new-property" class="rounded-lg py-2 px-10 bg-blue-500 hover:bg-blue-700 transition text-sm text-center text-white uppercase inline-block ml-4 sm:ml-8 my-10 mx-auto") publicar propiedad
        //- pre= JSON.stringify(properties, undefined, 2)

        if properties.length
            div(class="bg-white shadow-lg rounded-lg")
                ul(class="divide-y divide-gray-200")
                    each property in properties
                        li
                            div(class="p-6 w-full flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-8 md:space-y-0 gap-4")
                                div(class="sm:w-1/4 md:w1/6")
                                    img(src=`uploads/${property.imagen}` alt=`Imagen de la propiedad ${property.title}` class="w-full block")
                                div(class="sm:w-2/4 md:w-3/6 lg:w-4/6 text-center space-y-3")
                                    a(href="#" class="inline-block text-2xl font-extrabold text-blue-600 uppercase truncate")= property.title
                                    p(class="text-sm text-black font-bold")= property.category.category
                                    div(class="flex items-center justify-center gap-3")
                                        p(class="text-sm text-black font-bold")
                                           svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5")
                                            path(d="M10.75 10.818v2.614A3.13 3.13 0 0 0 11.888 13c.482-.315.612-.648.612-.875 0-.227-.13-.56-.612-.875a3.13 3.13 0 0 0-1.138-.432ZM8.33 8.62c.053.055.115.11.184.164.208.16.46.284.736.363V6.603a2.45 2.45 0 0 0-.35.13c-.14.065-.27.143-.386.233-.377.292-.514.627-.514.909 0 .184.058.39.202.592.037.051.08.102.128.152Z")
                                            path(fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-6a.75.75 0 0 1 .75.75v.316a3.78 3.78 0 0 1 1.653.713c.426.33.744.74.925 1.2a.75.75 0 0 1-1.395.55 1.35 1.35 0 0 0-.447-.563 2.187 2.187 0 0 0-.736-.363V9.3c.698.093 1.383.32 1.959.696.787.514 1.29 1.27 1.29 2.13 0 .86-.504 1.616-1.29 2.13-.576.377-1.261.603-1.96.696v.299a.75.75 0 1 1-1.5 0v-.3c-.697-.092-1.382-.318-1.958-.695-.482-.315-.857-.717-1.078-1.188a.75.75 0 1 1 1.359-.636c.08.173.245.376.54.569.313.205.706.353 1.138.432v-2.748a3.782 3.782 0 0 1-1.653-.713C6.9 9.433 6.5 8.681 6.5 7.875c0-.805.4-1.558 1.097-2.096a3.78 3.78 0 0 1 1.653-.713V4.75A.75.75 0 0 1 10 4Z" clip-rule="evenodd")
                                        p(class="text-sm text-black font-bold")= property.price.price
                                div(class="sm:w-1/4 md:w-2/6 lg:flex-1 flex flex-col gap-2 lg:flex-row")
                                    form(action="#")
                                        input(type="submit" class=`w-full px-2 py-2 cursor-pointer md:py-1 text-xs leading-5 font-semibold rounded-lg ${property.published ? 'bg-green-100 text-green-800': 'bg-yellow-100 text-yellow-800'}` value=`${property.published ? 'Publicado' : 'No Publicado'}`)
                                    
                                    a(href=`/properties/edit/${property.code}` class="px-2 py-2 text-center cursor-pointer md:py-1 text-sm leading-5 font-semibold rounded-lg bg-blue-100 text-blue-800") editar

                                    form(action=`/properties/delete/${property.code}` method="POST")
                                        input(type="hidden" name="_csrf" value= csrfToken)
                                        input(type="submit" class='w-full px-2 py-2 cursor-pointer md:py-1 text-xs leading-5 font-semibold rounded-lg bg-red-100 text-red-800' value="Eliminar")
        else
            div(class="bg-red-500 py-2 max-w-lg mx-auto")
                p(class="text-white text-center font-bold uppercase") No se encontraron propiedades creadas en tu cuenta