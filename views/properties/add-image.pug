extends ../layout/admin

block styles
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.css")
    meta(name="csrf-token" content=csrfToken) 

block contenido
    .py-10        
        div(class="bg-white shadow-lg py-8 px-4 rounded-lg mx-auto max-w-4xl my-10 md:px-10 space-y-5")
            h2(class="text-center text-3xl font-extrabold capitalize mb-10 text-gray-800")= pagina
            p(class="text-sm text-red-500 font-bold") formato de imagen permitido
                span(class="ml-2 font-normal") (.png .jpg .jpeg .webp)
            form(id="image" class="dropzone cursor-pointer border-dashed border-4 text-center w-full min-h-40  h-auto rounded flex justify-center items-center" enctype="multipart/form-data" action=`/properties/add-image/${property.code}` method="POST")
                input(type="hidden" name="_csrf" value= csrfToken)

            button(type="button" id="publish" class="py-3 mt-5 bg-blue-500 hover:bg-blue-700 transition w-full rounded-lg text-white cursor-pointer font-bold uppercase") Publicar Propiedad
    //- PRELOADER
    div#preloader.hidden.fixed.inset-0.z-50.flex.flex-col.items-center.justify-center.bg-white.bg-opacity-80
        div.loader.mb-4
        span.text-xl.font-semibold.text-gray-800 Cargando...

    //- Puedes agregarle estilos adicionales
    style.
        .loader {
            border: 6px solid #e5e7eb;
            border-top: 6px solid #3b82f6;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
block scripts
    script(src='/js/addImage.js')