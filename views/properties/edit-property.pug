extends ../layout/admin
block styles
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css")
block contenido
    .py-10
        if errors
            div(class="absolute top-40 right-10 z-20 max-w-md mx-auto md:top-25 md:right-5")
                each error in errors                
                    p(class="bg-red-600 rounded-lg transition-all text-white uppercase text-xs text-center p-2 mb-1.5 font-bold")=error.msg
        
        div(class="bg-white shadow-lg py-8 px-4 rounded-lg mx-auto max-w-4xl my-10 md:px-10")
            h2(class="text-center text-3xl font-extrabold uppercase text-gray-800")= pagina
            form(method="POST" class="space-y-8")
                input(type="hidden" name="_csrf" value= csrfToken)
                div.space-y-6
                    h3.text-lg.leading-6.mt-10.font-medium.text-gray-900.uppercase información general
                    p.text-gray-600 Agrega los detalles principales de la propiedad que deseas publicar
                    
                    div
                        label(for="title" class="block text-sm uppercase text-gray-500 mb-2 font-bold") titulo del propiedad
                        input(type="text" id="title" name="title" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400 cursor-pointer" placeholder="Casa en la playa" value= data.title ? data.title : '')

                    div
                        label(for="description" class="block text-sm uppercase text-gray-500 mb-2 font-bold") descripción de la propiedad
                        textarea(name="description" id="description" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400 cursor-pointer" placeholder="Casa en la playa cerca al mar")= data.description ? data.description : ''

                    div(class="space-y-5 md:flex md:gap-4 md:space-y-0")                   
                        div(class="md:w-1/2")
                            label(for="category" class="block text-sm uppercase text-gray-500 mb-2 font-bold") categoria
                            select(id="category" name="category" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400 cursor-pointer")
                                option(value="") -- Seleciona la categoria --
                                each categori in categories
                                    option(value=categori.id  selected= data.id_category ? data.id_category == categori.id ? true : false : null)= categori.category 
                        
                        div(class="md:w-1/2")
                            label(for="price" class="block text-sm uppercase text-gray-500 mb-2 font-bold") precio
                            select(id="price" name="price" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400 cursor-pointer")
                                option(value="") -- Seleciona el rango de precio --
                                each price in prices
                                    option(value=price.id selected= data.id_price ? data.id_price == price.id ? true : false: null )=  price.price

                    div(class="space-y-5 md:flex md:gap-4 md:space-y-0")                   
                        div(class="md:w-1/3")
                            label(for="rooms" class="block text-sm uppercase text-gray-500 mb-2 font-bold") habitaciones
                            select(id="rooms" name="rooms" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400 cursor-pointer")
                                option(value="") -- Cantidad de habitaciones --
                                - let h = 1;
                                    while h < 5
                                        option(value=h selected= data.rooms ? data.rooms == h ? true: false: null) #{h++}
                        
                        div(class="md:w-1/3")
                            label(for="bathrooms" class="block text-sm uppercase text-gray-500 mb-2 font-bold") baños
                            select(id="bathrooms" name="bathrooms" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400 cursor-pointer")
                                option(value="") -- Cantidad de baños --
                                - let b = 1;
                                    while b < 5
                                        option(value=b selected= data.bathrooms ? data.bathrooms == b ? true: false: null) #{b++}
                        div(class="md:w-1/3")
                            label(for="parking" class="block text-sm uppercase text-gray-500 mb-2 font-bold") parqueaderos
                            select(id="parking" name="parking" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400 cursor-pointer")
                                option(value="") -- Cantidad de parqueaderos --
                                - let p = 1;
                                    while p < 5
                                        option(value=p selected= data.parking ? data.parking == p ? true : false : null) #{p++}
                
                div.border-t.border-gray-200.space-y-5
                    h3.text-lg.leading-6.mt-10.font-medium.text-gray-900.uppercase Ubicación
                    p.text-gray-600 Indica dónde se encuentra la propiedad. Puedes buscar por dirección o punto de referencia.
                    div
                        label(for="search" class="text-sm uppercase text-gray-500 mb-2 font-bold flex items-center") Buscar ubicación 
                            span(class="text-gray-900 ml-2 text-[10px] font-bold") (presiona Enter para buscar)
                        input(type="text" id="search" name="search" placeholder="Ej. Casa de la Cultura, Medellín" class="w-full px-3 py-2 border border-gray-300 outline-none rounded-md placeholder-gray-400")
                        ul#suggestions.border.border-gray-200.absolute.bg-white.z-10
                    #mapa.h-96

                    div
                        p(class="street")= data.street ? data.street : ''
                    input(type="hidden" name="street" id="street" value= data.street ? data.street : '')
                    input(type="hidden" name="latitude" id="lat" value= data.latitude ? data.latitude : '' )
                    input(type="hidden" name="longitude" id="lng" value= data.longitude ? data.longitude : '')

                input(type="submit" class="py-3 bg-blue-500 hover:bg-blue-700 transition w-full rounded-lg text-white cursor-pointer font-bold uppercase" value="guardar cambios")
block scripts
    script(src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js")
    script(src="https://unpkg.com/esri-leaflet@3.0.8/dist/esri-leaflet.js")
    script(src="https://unpkg.com/esri-leaflet-geocoder@2.2.13/dist/esri-leaflet-geocoder.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/leaflet-geosearch/2.7.0/bundle.min.js")
    script(src="/js/mapa.js") 